# Get these from https://console.twilio.com (Account Info box)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Password to open the app (username can be anything)
APP_PASSWORD=change-me

# The public web address of this app, e.g. https://my-phone.onrender.com
# Needed so Twilio can deliver incoming texts and calls to you.
PUBLIC_URL=

PORT=3000
